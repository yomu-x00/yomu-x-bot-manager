# AES-256 encryption key (base64)
# Generate with: cd backend && uv run python -c "from crypto import generate_key; print(generate_key())"
ENCRYPTION_KEY=

# SQLite database path
DATABASE_PATH=../data/twitter.db

# Webhook secret token for POST /api/webhook/tweet (leave empty to disable auth)
WEBHOOK_SECRET=

# Discord webhook URL for cookie expiry alerts (leave empty to disable)
DISCORD_WEBHOOK_URL=

# Cloudflare Tunnel token (Zero Trust ダッシュボード → Tunnels → トンネル作成 → トークンをコピー)
CF_TUNNEL_TOKEN=
